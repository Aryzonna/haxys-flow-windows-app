{
  "name": "haxysflow",
  "productName": "Haxys Flow",
  "version": "1.1.17",
  "description": "Haxys Flow - ERP para agências",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron-forge start",
    "start:interna": "set HAXYS_EDICAO=interna&& electron-forge start",
    "test": "node test-settings.js",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "dist:publica": "electron-builder --win --config.extraMetadata.haxysEdicao=publica --config.directories.output=dist/publica",
    "dist:interna": "electron-builder --win --config.extraMetadata.haxysEdicao=interna --config.directories.output=dist/interna --config.publish.channel=interna --config.win.artifactName=HaxysFlow-Interna-Setup.exe",
    "dist": "npm run dist:publica && npm run dist:interna",
    "release": "node scripts/release.mjs"
  },
  "build": {
    "appId": "com.haxys.flow",
    "productName": "Haxys Flow",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "HaxysFlow-Setup.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "Haxys Flow",
      "uninstallDisplayName": "Haxys Flow",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerSidebar": null,
      "include": "build/installer.nsh"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "Aryzonna",
      "repo": "haxys-flow-windows-app",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "~35.0.0",
    "@electron-forge/cli": "^7.0.0",
    "@electron-forge/maker-squirrel": "^7.0.0",
    "@electron-forge/maker-zip": "^7.0.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.0.0",
    "electron-builder": "^26.0.0"
  },
  "author": "Haxys",
  "license": "MIT"
}
